<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

    // =========================================
    // TREE LOCATION MAP
    // =========================================

    let treeMap = null;


    function initializeTreeMap() {

    // Prevent the map from being initialized twice
    if (treeMap !== null) {
    treeMap.invalidateSize();
    return;
    }


    // =====================================
    // TEMPORARY COORDINATES
    // PALITAN NATIN ITO PAG MAY ACTUAL GPS
    // =====================================

    const tree1Location = [13.19800, 121.19833];

    const tree2Location = [13.176599, 121.187822];


    // =====================================
    // CREATE MAP
    // =====================================

    treeMap = L.map("treeMap").setView(
    tree1Location,
    16
    );


    // =====================================
    // OPENSTREETMAP TILES
    // =====================================

    L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
    attribution:
    "&copy; OpenStreetMap contributors"
    }
    ).addTo(treeMap);


    // =====================================
    // TREE 1 MARKER
    // =====================================

    const tree1 = L.marker(tree1Location)
    .addTo(treeMap);


    tree1.bindPopup(`
    <div style="text-align:center;">
    <h3>🌴 Tree 1</h3>
    <p><strong>Student:</strong> Tejada</p>
    <p><strong>Tree:</strong> Niyog / Coconut</p>
    <p><strong>GPS:</strong><br>
    13.1976470, 121.1983509</p>
    </div>
    `);


    // =====================================
    // TREE 2 MARKER
    // =====================================

    const tree2 = L.marker(tree2Location)
    .addTo(treeMap);


    tree2.bindPopup(`
    <div style="text-align:center;">
    <h3>🌿 Tree 2</h3>
    <p><strong>Student:</strong> Fabito</p>
    <p><strong>Tree:</strong> Malunggay / Moringa</p>
    <p><strong>GPS:</strong><br>
    13.1980000, 121.1990000</p>
    </div>
    `);

    }


    // =========================================
    // INITIALIZE WHEN LOCATION IS OPENED
    // =========================================

    function openTreeMap() {

    setTimeout(function () {

    initializeTreeMap();

    if (treeMap !== null) {
    treeMap.invalidateSize();
    }

    }, 200);

    }

</script>
